# ─── MAARVIS Environment Configuration ───────────────────────────────────────
# Copy this file to .env (or backend/.env) and fill in your values.

# ── App & Server Settings
APP_NAME=MAARVIS
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Supabase (Database, Auth, pgvector & Storage)
# Required in production. In local dev, falls back to embedded SQLite/storage if unset.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=documents

# ── Provider Credential Encryption
# Secret key used to encrypt user API keys at rest using AES-256-GCM.
PROVIDER_ENCRYPTION_KEY=

# ── Primary AI Provider (Minimum Configuration: Google Gemini)
# Users can bring their own API keys via the UI (Settings -> API & Providers),
# or you can configure a server-level fallback here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Optional Capability Providers
# JEV AI (Optional: semantic triage, calibrated confidence & advanced routing)
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# Web Search (Optional: live web verification via Tavily)
TAVILY_API_KEY=

# ── Verification Pipeline Tunables
MAX_VERIFICATION_ITERATIONS=3
CODE_EXECUTION_TIMEOUT=10
MAX_UPLOAD_SIZE_MB=20
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=10
RAG_FINAL_K=5
